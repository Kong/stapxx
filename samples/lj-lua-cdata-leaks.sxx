#!/usr/bin/env stap++

//@use nginx.lua
@use luajit_gc64

@define CT_MEMALIGN         %( 3 %)

@define sizeof_GCcdata      %( &@cast(0, "GCcdata", "$^libluajit_path")[1] %)
@define sizeof_GCcdataVar   %( &@cast(0, "GCcdataVar", "$^libluajit_path")[1] %)

global ptr_bt, ptr_size, bt_size

global is_in_inline_function = 0

function output_report() {
    delete ptr_bt
    delete ptr_size
    delete is_in_inline_function

    foreach (bt in bt_size- limit $^arg_limit :default(1000)) {
        total_size = bt_size[bt]

        if (total_size <= $^arg_min :default(1024)) {
            break
        }
        printf("%s\t%d\n", bt, total_size)
    }
}

probe process("$^libluajit_path").function("lj_cdata_free")
{
    if (pid() == target()) {
        bt = ptr_bt[$cd]
        size = ptr_size[$cd]

        delete ptr_bt[$cd]
        delete ptr_size[$cd]

        if (bt != "" && size) {
            bt_size[bt] -= size

            if (bt_size[bt] <= 0) {
                delete bt_size[bt]
            }
        }
    }
}

probe process("$^libluajit_path").function("lj_cdata_new")
{
    if (pid() == target()) {
        is_in_inline_function = 1
    }
}


probe process("$^libluajit_path").function("lj_cdata_newv").return
{
    if (pid() == target() && $return && !ptr_size[$return]) {
        bt = luajit_backtrace(@entry($L), luajit_G(@entry($L)), $^arg_detailed :default(0) ? 0 : 1)
        if (bt != "") {
            bt = "cdata:" . bt
            
            extra = @sizeof_GCcdataVar + @sizeof_GCcdata +
		        ($align > @CT_MEMALIGN ? (1 << $align) - (1 << @CT_MEMALIGN) : 0);

            ptr_bt[$return] = bt
            ptr_size[$return] = extra + @entry($sz)
            bt_size[bt] += extra + @entry($sz)
        }
    }
}


probe process("$^libluajit_path").function("lj_cdata_new_")
{
    if (pid() == target()) {
        is_in_inline_function = 1
    }
}


probe process("$^libluajit_path").function("lj_mem_newgco").return
{
    if (pid() == target() && is_in_inline_function == 1 && $return && !ptr_size[$return]) {
        is_in_inline_function = 0
        bt = luajit_backtrace(@entry($L), luajit_G(@entry($L)), $^arg_detailed :default(0) ? 0 : 1)

        if (bt != "") {
            bt = "cdata:" . bt

            ptr_bt[$return] = bt
            ptr_size[$return] = @entry($size)
            bt_size[bt] += @entry($size)
        }
    }
}


%( "$^arg_time :default()" != ""  %?
probe timer.s($^arg_time)
{
    warn("Time's up. Quitting now...\n")
    exit()
}
%)


probe end {
    output_report()
}


probe begin
{
    warn(sprintf("Start tracing %d ($^exec_path)\n", target()))
    %( "$^arg_time" != ""  %?
    warn(sprintf("Please wait for $^arg_time seconds...\n"))
    %:
    warn("Hit Ctrl-C to end.\n")
    %)
}

